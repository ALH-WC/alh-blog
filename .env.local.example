# Copy this file to .env.local and fill in your Sanity values.
# .env.local is gitignored. NEVER commit real tokens.

# Public (safe to expose to the browser) - from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only write token (Editor role). Used by API routes / server actions.
# Create at Manage > API > Tokens. Put the real value here locally and in
# Vercel Project Settings > Environment Variables. Do NOT prefix with NEXT_PUBLIC.
SANITY_API_WRITE_TOKEN=

# Optional: where lead-magnet / newsletter emails should be forwarded once wired
# to a real ESP. Left blank in the stub.
ESP_API_KEY=
